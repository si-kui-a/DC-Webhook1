# 複製此檔為 .env 後填入實際值。.env 不應進版控（見 .gitignore）。

WEBHOOK_INSTITUTIONAL_TSMC=https://discord.com/api/webhooks/
WEBHOOK_INSTITUTIONAL_FED=https://discord.com/api/webhooks/
WEBHOOK_INSTITUTIONAL_CBC=https://discord.com/api/webhooks/
WEBHOOK_INSTITUTIONAL_0050=https://discord.com/api/webhooks/
WEBHOOK_INSTITUTIONAL_MACRO=https://discord.com/api/webhooks/
# 美股送分題(Substack)——只推免費預覽,不推Telegram,需開一個獨立DC頻道
WEBHOOK_ANALYST_EASYPOINT=https://discord.com/api/webhooks/
# 獎學金來源共用一個 webhook（批次推播，依來源分組）
WEBHOOK_SCHOLARSHIP=https://discord.com/api/webhooks/

# fed/tsmc(英文來源)中文翻譯+利多利空判斷用,Google AI Studio免費層申請。
# 留空則靜默跳過AI翻譯,退回原本的英文抽取式摘要,不影響其餘功能。
GEMINI_API_KEY=
