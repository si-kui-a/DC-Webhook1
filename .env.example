# 複製此檔為 .env 後填入實際值。.env 不應進版控（見 .gitignore）。

WEBHOOK_INSTITUTIONAL_TSMC=https://discord.com/api/webhooks/
WEBHOOK_INSTITUTIONAL_FED=https://discord.com/api/webhooks/
WEBHOOK_INSTITUTIONAL_CBC=https://discord.com/api/webhooks/
WEBHOOK_INSTITUTIONAL_0050=https://discord.com/api/webhooks/
WEBHOOK_INSTITUTIONAL_MACRO=https://discord.com/api/webhooks/
# 美股送分題(Substack)——只推免費預覽,不推Telegram,需開一個獨立DC頻道
WEBHOOK_ANALYST_EASYPOINT=https://discord.com/api/webhooks/
# 獎學金來源共用一個 webhook（批次推播，依來源分組）
WEBHOOK_SCHOLARSHIP=https://discord.com/api/webhooks/
# 中華電財報/營收(純事實陳述,TWSE官方開放資料,無AI)——新公司,獨立頻道
WEBHOOK_CHUNGHWA=https://discord.com/api/webhooks/
# 以下3個是晚間彙整頻道(甲類:AI敘事交叉比對),Phase 3新建
WEBHOOK_CRYPTO=https://discord.com/api/webhooks/
WEBHOOK_MACRO_TECH=https://discord.com/api/webhooks/
WEBHOOK_GEOPOLITICS=https://discord.com/api/webhooks/
# 總經指標(VIX/殖利率/信用利差/那斯達克/費半)任一觸發閾值時額外推播的
# 獨立警報頻道，跟每日固定報告的WEBHOOK_INSTITUTIONAL_MACRO分開
WEBHOOK_MACRO_ALERT=https://discord.com/api/webhooks/
# 大總結頻道(彙整其餘頻道當天已產出的內容,AI綜合研判進出場/情緒)
WEBHOOK_TW_STOCK_META=https://discord.com/api/webhooks/
WEBHOOK_CRYPTO_META=https://discord.com/api/webhooks/
# 模擬持倉(紙上帳戶,一倉一頻道,使用者確認2026-07-30)
WEBHOOK_PORTFOLIO_TW_STOCK=https://discord.com/api/webhooks/
WEBHOOK_PORTFOLIO_CRYPTO_FUTURES=https://discord.com/api/webhooks/
WEBHOOK_PORTFOLIO_CRYPTO_DISCRETIONARY=https://discord.com/api/webhooks/

# fed/tsmc(英文來源)中文翻譯+利多利空判斷用,Google AI Studio免費層申請。
# 留空則靜默跳過AI翻譯,退回原本的英文抽取式摘要,不影響其餘功能。
GEMINI_API_KEY=

# scripts/discord_admin.py 用:代管建頻道/建webhook的Bot(沿用MyScholarshipBot)。
# Token在Discord Developer Portal > Bot頁 > Token取得,等同密碼不可外流。
DISCORD_BOT_TOKEN=
# 目標伺服器的數字ID(非邀請連結),開發者模式後右鍵伺服器>複製伺服器ID取得。
DISCORD_GUILD_ID=
