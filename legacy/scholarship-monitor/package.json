{
  "name": "scholarship-monitor",
  "version": "1.0.0",
  "description": "個人專用獎學金資訊自動化監測系統（風險收斂版：無 n8n / 無常駐 Ollama）",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "run:once": "node src/index.js --once",
    "report:daily": "node src/report/generateReport.js daily",
    "report:weekly": "node src/report/generateReport.js weekly"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1",
    "node-cron": "^3.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
